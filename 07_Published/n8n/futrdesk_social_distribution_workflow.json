            "index": 0
          }
        ]
      ]
    },
    "Stagger Delay 1": {
      "main": [
        [
          {
            "node": "X/Twitter Publisher",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "X/Twitter Publisher": {
      "main": [
        [
          {
            "node": "Stagger Delay 2",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Stagger Delay 2": {
      "main": [
        [
          {
            "node": "YouTube Shorts Publisher",
