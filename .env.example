# ============================================================================
# Futrdesk Environment Variables
# Copy to .env.local and fill in values. NEVER commit .env.local.
# ============================================================================

# --- App ---
APP_URL=http://localhost:3000
CRON_SECRET=generate-a-long-random-string

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Groq Console) ---
GROQ_API_KEY=

# --- WhatsApp Cloud API (Meta Developer Dashboard) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional but recommended: App Secret for X-Hub-Signature-256 verification
WHATSAPP_APP_SECRET=

# --- Telegram (via @BotFather) ---
TELEGRAM_BOT_TOKEN=

# --- Email: Plunk (https://app.useplunk.com) ---
PLUNK_SECRET_API_KEY=
# Sender addresses must be verified in Plunk:
MAIL_FROM_INVOICES=invoices@futrdesk.com
MAIL_FROM_ALERTS=alerts@futrdesk.com
MAIL_FROM_EXPORT=export@futrdesk.com

# --- Billing: Lemon Squeezy ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_SHOP_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_PRODUCT_STARTER_ID=
LEMON_SQUEEZY_PRODUCT_PRO_ID=
LEMON_SQUEEZY_PRODUCT_BUSINESS_ID=
LEMON_SQUEEZY_PRODUCT_EINZELRECHNUNG=
LEMON_SQUEEZY_PRODUCT_RECHNUNGSPAKET_20=
LEMON_SQUEEZY_PRODUCT_RECHNUNGSPAKET_50=

# --- Future integrations (not yet wired) ---
PARTNERSTACK_API_KEY=
PAVED_API_KEY=
